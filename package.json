{
  "name": "cyrus-portfolio",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @cyrus/web dev",
    "dev:resume": "pnpm --filter @cyrus/resume dev",
    "build": "pnpm --filter @cyrus/web build",
    "build:resume": "pnpm --filter @cyrus/resume build",
    "typecheck": "pnpm --filter @cyrus/web typecheck",
    "typecheck:resume": "pnpm --filter @cyrus/resume typecheck",
    "lint": "oxlint .",
    "fmt": "oxfmt --write .",
    "pre-commit": "pnpm fmt && pnpm lint"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0"
  },
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=11.11.0"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
