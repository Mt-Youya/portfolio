{
  "name": "cyrus-portfolio",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @cyrus/web dev",
    "dev:resume": "pnpm --filter @cyrus/resume dev",
    "build": "pnpm --filter @cyrus/web build",
    "build:resume": "pnpm --filter @cyrus/resume build",
    "typecheck": "pnpm --filter @cyrus/web typecheck",
    "typecheck:resume": "pnpm --filter @cyrus/resume typecheck",
    "lint": "oxlint .",
    "fmt": "oxfmt --write .",
    "pre-commit": "pnpm fmt && pnpm lint"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "vercel": "^57.0.0"
  },
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=11.11.0"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
